# MiMo API
MIMO_API_KEY=your_api_key_here
MIMO_API_KEYS=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MODEL_FAST=mimo-v2-flash
MIMO_MODEL_OMNI=mimo-v2-omni

# 模型供应商默认选择
DEFAULT_MODEL_PROVIDER=mimo
DEFAULT_MODEL=

# 火山方舟 API（OpenAI 兼容）
# ARK_MODEL 通常填写火山方舟的模型 ID 或推理接入点 Endpoint ID
ARK_API_KEY=
ARK_API_KEYS=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_MODEL_FAST=
ARK_MODEL_OMNI=

# 也支持 VOLCENGINE_* 别名
VOLCENGINE_API_KEY=
VOLCENGINE_API_KEYS=
VOLCENGINE_BASE_URL=
VOLCENGINE_MODEL=
VOLCENGINE_MODEL_FAST=
VOLCENGINE_MODEL_OMNI=

# 可选：通过 JSON 扩展任意 OpenAI 兼容供应商
# MODEL_PROVIDERS=[{"id":"custom","label":"Custom","base_url":"https://example.com/v1","api_key":"sk-...","models":[{"id":"model-id","label":"Model"}]}]
MODEL_PROVIDERS=

# TTS
TTS_ENGINE=mimo-tts
TTS_MIMO_MODEL=mimo-v2.5-tts
TTS_FALLBACK_ENGINE=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 向量库：开发默认 Chroma；生产可设置 VECTOR_STORE=qdrant 并启动 Qdrant 服务
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=agent_demo
QDRANT_VECTOR_SIZE=768

# 嵌入模型
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# 记忆
SHORT_TERM_DB=./data/memory.db
LONG_TERM_DB=./data/long_term.db

# MCP
MCP_CONFIG_PATH=./mcp_servers/config.json

# 搜索工具：按顺序 fallback。可选 baidu,sogou,duckduckgo,bing
SEARCH_ENGINES=baidu,sogou,duckduckgo,bing
SEARCH_TIMEOUT_SECONDS=8
